---
import { COMPANY, CONTENT, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = CONTENT[lang].contactPage;
---

<section class="bg-canvas py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      <span>{c.badge}</span>
    </span>

    <h1 class="heading-editorial mt-7 text-4xl leading-[1.18] text-ink sm:text-5xl">
      <span class="block">{c.titleMain}</span>
      <span class="mt-1 block text-accent">{c.titleAccent}</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-muted">
      {c.subtitle}
    </p>

    <div class="mx-auto mt-12 grid max-w-2xl gap-6 sm:grid-cols-2">
      <a
        href={`mailto:${COMPANY.email}`}
        class="group rounded-2xl border border-border bg-surface p-7 text-start transition-colors hover:border-accent"
      >
        <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-muted">{c.emailLabel}</p>
        <p class="mt-1.5 font-mono text-base font-bold text-ink group-hover:text-accent" dir="ltr">
          {COMPANY.email}
        </p>
      </a>

      <a
        href={COMPANY.githubOrg}
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-2xl border border-border bg-surface p-7 text-start transition-colors hover:border-accent"
      >
        <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
          </svg>
        </div>
        <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-muted">{c.githubLabel}</p>
        <p class="mt-1.5 font-mono text-base font-bold text-ink group-hover:text-accent" dir="ltr">
          github.com/Arshid-Tech
        </p>
      </a>
    </div>
  </div>
</section>
