---
import { COMPANY, CONTENT, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = CONTENT[lang].contactPage;
const f = c.form;
---

<section class="bg-canvas py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-12 lg:grid-cols-12">
      <!-- Left Column (Harris Healthcare Contact Info & Follow Us) -->
      <div class="lg:col-span-5">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
          <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>{c.badge}</span>
        </span>

        <h1 class="heading-editorial mt-7 text-4xl leading-[1.15] text-ink sm:text-5xl">
          <span class="block">{c.titleLine1}</span>
          <span class="mt-1 block">{c.titleLine2}</span>
        </h1>

        <p class="mt-6 text-base leading-8 text-muted">
          {c.subtitle}
        </p>

        <h2 class="heading-editorial mt-10 text-xl text-ink">
          {c.directHeading}
        </h2>

        <!-- Contact Card -->
        <div class="mt-4 rounded-2xl border border-border bg-surface p-6 shadow-[0_1px_2px_rgba(6,50,59,0.03)]">
          <div class="flex items-start gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-border bg-accent-soft p-2.5">
              <img
                src="/images/brand/icon-mark.svg"
                alt={COMPANY.brand[lang]}
                class="h-full w-full object-contain dark:invert"
                width="96"
                height="96"
              />
            </div>
            <div class="min-w-0">
              <p class="text-base font-bold text-ink">{c.cardTitle}</p>
              <p class="mt-0.5 text-xs font-semibold text-accent">{c.cardRole}</p>
              <p class="mt-3 text-sm leading-7 text-muted">
                {c.cardBio}
              </p>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap gap-2.5 border-t border-border pt-4">
            <a
              href={COMPANY.telegramDirect}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-accent-soft px-3.5 py-2 text-xs font-semibold text-accent transition-colors hover:bg-accent hover:text-white"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.944 4.212a1 1 0 0 0-1.053-.143L2.62 11.24a1 1 0 0 0 .066 1.884l4.53 1.51 1.74 5.22a1 1 0 0 0 1.662.388l2.52-2.52 4.44 3.255a1 1 0 0 0 1.568-.6l2.98-15.02a1 1 0 0 0-.182-.745ZM9.74 14.37l-.72 3.19-.96-2.88 9.21-6.51-7.53 6.2Z" />
              </svg>
              <span>{c.telegramDirectLabel}</span>
            </a>

            <a
              href={`mailto:${COMPANY.email}`}
              class="inline-flex items-center gap-2 rounded-xl border border-border bg-canvas px-3.5 py-2 text-xs font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
            >
              <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span dir="ltr">{COMPANY.email}</span>
            </a>
          </div>
        </div>

        <!-- Follow Us -->
        <div class="mt-9">
          <h3 class="heading-editorial text-lg text-ink">{c.followHeading}</h3>
          <div class="mt-4 flex items-center gap-3">
            <a
              href={COMPANY.telegramChannel}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={c.telegramChannelLabel}
              title={c.telegramChannelLabel}
              class="inline-flex h-11 items-center gap-2.5 rounded-xl bg-accent-soft px-4 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-white"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.944 4.212a1 1 0 0 0-1.053-.143L2.62 11.24a1 1 0 0 0 .066 1.884l4.53 1.51 1.74 5.22a1 1 0 0 0 1.662.388l2.52-2.52 4.44 3.255a1 1 0 0 0 1.568-.6l2.98-15.02a1 1 0 0 0-.182-.745ZM9.74 14.37l-.72 3.19-.96-2.88 9.21-6.51-7.53 6.2Z" />
              </svg>
              <span>{c.telegramChannelLabel}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column (Harris Healthcare Contact Form Card) -->
      <div class="lg:col-span-7">
        <form
          id="arshid-contact-form"
          data-recipient={COMPANY.email}
          class="rounded-3xl border border-border bg-surface p-6 shadow-[0_1px_3px_rgba(6,50,59,0.03)] sm:p-9"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="firstName" class="block text-sm font-semibold text-ink">{f.firstName}</label>
              <input
                id="firstName"
                name="firstName"
                type="text"
                required
                placeholder={f.firstNamePh}
                class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
              />
            </div>

            <div>
              <label for="lastName" class="block text-sm font-semibold text-ink">{f.lastName}</label>
              <input
                id="lastName"
                name="lastName"
                type="text"
                required
                placeholder={f.lastNamePh}
                class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
              />
            </div>
          </div>

          <div class="mt-5">
            <label for="email" class="block text-sm font-semibold text-ink">{f.email}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              dir="ltr"
              placeholder={f.emailPh}
              class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
            />
          </div>

          <div class="mt-5">
            <label for="company" class="block text-sm font-semibold text-ink">{f.company}</label>
            <input
              id="company"
              name="company"
              type="text"
              placeholder={f.companyPh}
              class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
            />
          </div>

          <div class="mt-5">
            <label for="subject" class="block text-sm font-semibold text-ink">{f.subject}</label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              placeholder={f.subjectPh}
              class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
            />
          </div>

          <div class="mt-5">
            <label for="message" class="block text-sm font-semibold text-ink">{f.message}</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder={f.messagePh}
              class="mt-2 w-full rounded-xl border border-border bg-canvas/50 px-4 py-3 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-6 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#06323B] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#094754] dark:bg-aqua dark:text-[#06323B] dark:hover:bg-aqua-hover"
          >
            <span>{f.submit}</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

          <p class="mt-3 text-center text-xs leading-6 text-muted">
            {f.helper}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('arshid-contact-form');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const recipient = form.getAttribute('data-recipient') || 'info@arshid.tech';
      const data = new FormData(form);
      const fullName = `${data.get('firstName') || ''} ${data.get('lastName') || ''}`.trim();
      const email = data.get('email') || '';
      const company = data.get('company') || '-';
      const subject = data.get('subject') || 'Arshid Tech Inquiry';
      const message = data.get('message') || '';

      const body = [
        `Name: ${fullName}`,
        `Email: ${email}`,
        `Organization: ${company}`,
        '',
        message,
      ].join('\n');

      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
