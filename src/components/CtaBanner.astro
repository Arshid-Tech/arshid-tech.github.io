---
import { CONTENT, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang].cta;
const prefix = lang === 'fa' ? '' : '/en';
const arrow = lang === 'fa' ? '←' : '→';
---

<section class="cta-gradient text-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <h2 class="heading-editorial text-3xl text-white sm:text-4xl lg:text-[2.75rem] lg:leading-tight">
          {t.title}
        </h2>
        <p class="mt-4 max-w-lg text-base leading-8 text-white/75">
          {t.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href={`${prefix}/contact/`}
            class="inline-flex items-center gap-2 rounded-full bg-aqua px-6 py-3 text-sm font-semibold text-[#06323B] transition-colors hover:bg-aqua-hover"
          >
            <span>{t.primaryBtn}</span>
            <span aria-hidden="true">{arrow}</span>
          </a>
          <a
            href={`${prefix}/philosophy/`}
            class="inline-flex items-center rounded-full border border-white/25 bg-white/8 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/15"
          >
            {t.secondaryBtn}
          </a>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:col-span-6">
        <div>
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-aqua">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-white">{t.card1Title}</h3>
          <p class="mt-2 text-sm leading-7 text-white/70">{t.card1Desc}</p>
          <a
            href={`${prefix}/portfolio/`}
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-aqua transition-colors hover:text-white"
          >
            <span>{t.card1Link}</span>
            <span aria-hidden="true">{arrow}</span>
          </a>
        </div>

        <div>
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-aqua">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
            </svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-white">{t.card2Title}</h3>
          <p class="mt-2 text-sm leading-7 text-white/70">{t.card2Desc}</p>
          <a
            href={`${prefix}/blog/`}
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-aqua transition-colors hover:text-white"
          >
            <span>{t.card2Link}</span>
            <span aria-hidden="true">{arrow}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
