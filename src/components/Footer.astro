---
import { COMPANY, CONTENT, PROJECTS, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const f = CONTENT[lang].footer;
const nav = CONTENT[lang].nav;
const prefix = lang === 'fa' ? '' : '/en';
const logoSrc =
  lang === 'fa'
    ? '/images/brand/logo-horizontal-fa-white.svg'
    : '/images/brand/logo-horizontal-en-white.svg';
const logoWidth = lang === 'fa' ? 226 : 233;
---

<footer class="border-t border-white/10 bg-nav text-sm text-white/75">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href={`${prefix}/`} class="inline-block no-underline" aria-label={COMPANY.brand[lang]}>
          <img
            src={logoSrc}
            alt={COMPANY.brand[lang]}
            class="h-10 w-auto"
            width={logoWidth}
            height="104"
          />
        </a>
        <p class="mt-4 max-w-sm text-sm leading-7 text-white/70">
          {COMPANY.tagline[lang]}
        </p>
        <div class="mt-6 flex items-center gap-2.5">
          <a
            href={COMPANY.telegramChannel}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={f.telegramChannel}
            title={f.telegramChannel}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 text-white/85 transition-colors hover:bg-white/18 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21.944 4.212a1 1 0 0 0-1.053-.143L2.62 11.24a1 1 0 0 0 .066 1.884l4.53 1.51 1.74 5.22a1 1 0 0 0 1.662.388l2.52-2.52 4.44 3.255a1 1 0 0 0 1.568-.6l2.98-15.02a1 1 0 0 0-.182-.745ZM9.74 14.37l-.72 3.19-.96-2.88 9.21-6.51-7.53 6.2Z" />
            </svg>
          </a>
          <a
            href={`mailto:${COMPANY.email}`}
            aria-label="Email"
            title={COMPANY.email}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 text-white/85 transition-colors hover:bg-white/18 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-2">
        <p class="font-semibold text-white">{f.companyHeading}</p>
        <ul class="mt-4 space-y-2.5 text-white/70">
          <li><a href={`${prefix}/philosophy/`} class="transition-colors hover:text-white">{nav.philosophy}</a></li>
          <li><a href={`${prefix}/portfolio/`} class="transition-colors hover:text-white">{nav.portfolio}</a></li>
          <li><a href={`${prefix}/blog/`} class="transition-colors hover:text-white">{nav.blog}</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="font-semibold text-white">{f.productsHeading}</p>
        <ul class="mt-4 space-y-2.5 text-white/70">
          {PROJECTS.map((project) => (
            <li>
              <a
                href={project.url[lang]}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
                class="transition-colors hover:text-white"
              >
                {project.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="font-semibold text-white">{f.contactHeading}</p>
        <ul class="mt-4 space-y-2.5 text-white/70">
          <li>
            <a href={`${prefix}/contact/`} class="inline-flex items-center gap-2 transition-colors hover:text-white">
              <svg class="h-4 w-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>{f.getInTouch}</span>
            </a>
          </li>
          <li>
            <a
              href={COMPANY.telegramDirect}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 transition-colors hover:text-white"
            >
              <svg class="h-4 w-4 opacity-80" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.944 4.212a1 1 0 0 0-1.053-.143L2.62 11.24a1 1 0 0 0 .066 1.884l4.53 1.51 1.74 5.22a1 1 0 0 0 1.662.388l2.52-2.52 4.44 3.255a1 1 0 0 0 1.568-.6l2.98-15.02a1 1 0 0 0-.182-.745ZM9.74 14.37l-.72 3.19-.96-2.88 9.21-6.51-7.53 6.2Z" />
              </svg>
              <span>{f.telegramDirect}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${COMPANY.email}`} class="font-mono text-xs transition-colors hover:text-white" dir="ltr">
              {COMPANY.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row sm:items-center">
      <p>{f.rights}</p>
      <p dir="ltr">arshid.tech</p>
    </div>
  </div>
</footer>
