---
import { COMPANY, PROJECTS, UI, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const f = UI[lang].footer;
const nav = UI[lang].nav;
const homeHref = lang === 'fa' ? '/' : '/en/';
const blogHref = lang === 'fa' ? '/blog/' : '/en/blog/';
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface text-sm text-muted">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-base font-bold text-ink">{COMPANY.legalName[lang]}</p>
        <p class="mt-3 leading-relaxed text-muted">{COMPANY.address[lang]}</p>
        <dl class="mt-4 grid grid-cols-1 gap-1.5 text-xs text-muted sm:grid-cols-2">
          <div>
            <dt class="inline font-medium text-ink">{f.regLabel}:</dt>
            <dd class="inline ps-1">{COMPANY.registrationNumber[lang]}</dd>
          </div>
          <div>
            <dt class="inline font-medium text-ink">{f.nationalIdLabel}:</dt>
            <dd class="inline ps-1">{COMPANY.nationalId[lang]}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="inline font-medium text-ink">{f.postalLabel}:</dt>
            <dd class="inline ps-1">{COMPANY.postalCode[lang]}</dd>
          </div>
        </dl>
      </div>

      <div class="md:col-span-4">
        <p class="font-semibold text-ink">{f.productsHeading}</p>
        <ul class="mt-3 space-y-2">
          {PROJECTS.map((project) => (
            <li>
              <a
                href={project.url[lang]}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
                class="transition-colors hover:text-primary"
              >
                {project.name}
                <span class="ms-1.5 text-xs text-muted/80" dir="ltr">({project.domainLabel})</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="font-semibold text-ink">{f.linksHeading}</p>
        <ul class="mt-3 space-y-2">
          <li><a href={`${homeHref}#services`} class="transition-colors hover:text-primary">{nav.services}</a></li>
          <li><a href={blogHref} class="transition-colors hover:text-primary">{nav.blog}</a></li>
          <li><a href={`mailto:${COMPANY.email}`} class="transition-colors hover:text-primary" dir="ltr">{COMPANY.email}</a></li>
          <li>
            <a href={COMPANY.githubOrg} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
              GitHub / Arshid-Tech
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center">
      <p>&copy; {year} {f.rights}</p>
      <p dir="ltr">arshid.tech</p>
    </div>
  </div>
</footer>
