---
import { COMPANY, type Locale } from '../data/site';
import CtaBanner from './CtaBanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const portfolioHref = lang === 'fa' ? '/portfolio/' : '/en/portfolio/';

const content = {
  fa: {
    back: 'بازگشت به محصولات',
    eyebrow: 'اپلیکیشن موبایل بالینی · hamrah-iv.arshid.tech',
    title: 'همراه IV (Hamrah-IV)',
    subtitle: 'مرجع فارسی و آفلاین بررسی سازگاری داروهای تزریقی وریدی (IV Compatibility) برای داروسازان، پرستاران و کادر درمان.',
    ctaTelegram: 'پیام در تلگرام',
    ctaEmail: 'ارسال ایمیل',
    featuresTitle: 'ویژگی‌های بالینی و فنی',
    features: [
      {
        title: 'دیتابیس کاملاً آفلاین',
        desc: 'جستجو و استعلام سازگاری جفت‌های دارویی بدون نیاز به اینترنت در بخش‌های بیمارستانی و مراقبت ویژه.',
      },
      {
        title: 'تفکیک دقیق مسیر تزریق و وضعیت سازگاری',
        desc: 'فیلتر سریع نتایج بر اساس وضعیت سازگاری، غلظت دارویی، مسیر تزریق و یادداشت‌های بالینی فارسی.',
      },
      {
        title: 'همگام‌سازی امن و نسخه‌بندی‌شده',
        desc: 'به‌روزرسانی پایگاه داده با بررسی صحت فایل و حفظ یکپارچگی داده‌های محلی.',
      },
      {
        title: 'طراحی‌شده برای سرعت در محیط درمان',
        desc: 'پشتیبانی از حالت روشن و تاریک، جستجوی هوشمند نام‌های دارویی و نمایش شفاف شواهد.',
      },
    ],
  },
  en: {
    back: 'Back to Portfolio',
    eyebrow: 'Mobile Clinical Application · hamrah-iv.arshid.tech',
    title: 'Hamrah-IV',
    subtitle: 'Offline-first Persian mobile reference for intravenous (IV) drug compatibility built for pharmacists, nurses, and hospital clinicians.',
    ctaTelegram: 'Message on Telegram',
    ctaEmail: 'Email Us',
    featuresTitle: 'Clinical & Engineering Capabilities',
    features: [
      {
        title: 'Fully Offline Database',
        desc: 'Instant pairwise IV compatibility lookups with zero network dependency inside hospital wards and ICUs.',
      },
      {
        title: 'Route-Aware Filtering & Clinical Notes',
        desc: 'Filter compatibility outcomes by clinical route, drug concentration, and Persian clinical guidance notes.',
      },
      {
        title: 'Verified Dataset Synchronization',
        desc: 'Versioned database updates via trusted manifest validation and integrity checks.',
      },
      {
        title: 'Built for Clinical Shift Speed',
        desc: 'Light and dark themes, normalized drug search, and high-contrast compatibility indicators.',
      },
    ],
  },
}[lang];
---

<section class="border-b border-border/70 bg-canvas py-12 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <a href={portfolioHref} class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted hover:text-accent">
      <span aria-hidden="true">{lang === 'fa' ? '→' : '←'}</span>
      <span>{content.back}</span>
    </a>

    <p class="mt-6 break-words font-mono text-xs font-semibold text-accent">{content.eyebrow}</p>
    <h1 class="heading-editorial mt-3 text-3xl text-ink sm:text-5xl">{content.title}</h1>
    <p class="mt-4 text-sm leading-8 text-muted sm:mt-5 sm:text-lg">{content.subtitle}</p>

    <div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-8">
      <a
        href={COMPANY.telegramDirect}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[#06323B] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#094754] sm:px-6 sm:py-3 dark:bg-aqua dark:text-[#06323B] dark:hover:bg-aqua-hover"
      >
        <span>{content.ctaTelegram}</span>
      </a>
      <a
        href={`mailto:${COMPANY.email}?subject=Hamrah-IV%20Access`}
        class="inline-flex items-center rounded-full border border-ink/25 bg-surface px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent sm:px-6 sm:py-3"
      >
        {content.ctaEmail}
      </a>
    </div>
  </div>
</section>

<section class="py-12 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h2 class="heading-editorial text-2xl text-ink sm:text-3xl">{content.featuresTitle}</h2>
    <div class="mt-7 grid gap-5 sm:mt-8 sm:grid-cols-2 sm:gap-6">
      {content.features.map((item) => (
        <div class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
          <h3 class="text-base font-bold text-ink">{item.title}</h3>
          <p class="mt-2.5 text-sm leading-7 text-muted">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />
