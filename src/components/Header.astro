---
import { COMPANY, UI, type Locale } from '../data/site';

interface Props {
  lang: Locale;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = UI[lang].nav;
const homeHref = lang === 'fa' ? '/' : '/en/';
const blogHref = lang === 'fa' ? '/blog/' : '/en/blog/';
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={homeHref} class="flex items-center gap-2.5 text-ink no-underline">
      <svg class="h-7 w-7 shrink-0" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#0F4C5C" />
        <path d="M9 22L15.2 9.5H17.1L23 22H20.3L19 19.1H13.1L11.7 22H9ZM14.1 16.9H18L16.1 12.6L14.1 16.9Z" fill="#F8FAFC" />
        <rect x="21.5" y="8.5" width="3.5" height="3.5" rx="0.75" fill="#0D9488" />
      </svg>
      <span class="text-base font-bold tracking-tight text-ink">{COMPANY.brand[lang]}</span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-7 text-sm font-medium text-muted md:flex">
      <a href={`${homeHref}#products`} class="transition-colors hover:text-primary">{t.products}</a>
      <a href={`${homeHref}#services`} class="transition-colors hover:text-primary">{t.services}</a>
      <a href={blogHref} class="transition-colors hover:text-primary">{t.blog}</a>
      <a href={`${homeHref}#about`} class="transition-colors hover:text-primary">{t.about}</a>
      <a href={`${homeHref}#contact`} class="transition-colors hover:text-primary">{t.contact}</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={alternatePath}
        class="inline-flex items-center rounded border border-border bg-bg px-3 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-primary hover:text-primary"
        hreflang={lang === 'fa' ? 'en' : 'fa'}
      >
        {t.switchLang}
      </a>
      <a
        href={COMPANY.githubOrg}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center rounded bg-primary px-3.5 py-1.5 text-xs font-medium text-white transition-colors hover:bg-primary-dark sm:inline-flex"
      >
        GitHub
      </a>
    </div>
  </div>
</header>
