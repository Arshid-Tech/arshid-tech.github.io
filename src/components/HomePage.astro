---
import { CONTENT, PROJECTS, type Locale } from '../data/site';
import CtaBanner from './CtaBanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang];
const prefix = lang === 'fa' ? '' : '/en';
const arrow = lang === 'fa' ? '←' : '→';
---

<!-- 1. Hero Section (Harris Healthcare split layout) -->
<section class="relative overflow-hidden border-b border-border/70 bg-canvas">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h1 class="heading-editorial text-4xl leading-[1.18] text-ink sm:text-5xl lg:text-[3.5rem]">
          <span class="block">{t.hero.titleMain}</span>
          <span class="mt-1 block text-accent">{t.hero.titleAccent}</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-muted sm:text-[1.06rem]">
          {t.hero.p1}
        </p>
        <p class="mt-4 max-w-xl text-base leading-8 text-muted sm:text-[1.06rem]">
          {t.hero.p2}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3.5">
          <a
            href={`${prefix}/philosophy/`}
            class="inline-flex items-center gap-2 rounded-full bg-[#06323B] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#094754] dark:bg-aqua dark:text-[#06323B] dark:hover:bg-aqua-hover"
          >
            <span>{t.hero.primaryCta}</span>
            <span aria-hidden="true">{arrow}</span>
          </a>
          <a
            href={`${prefix}/portfolio/`}
            class="inline-flex items-center rounded-full border border-ink/25 bg-surface/60 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
          >
            {t.hero.secondaryCta}
          </a>
        </div>
      </div>

      <!-- Subtle Editorial Ecosystem Visual -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl border border-border bg-surface p-6 shadow-sm sm:p-7">
          <div class="pointer-events-none absolute -bottom-8 -end-8 h-40 w-40 rounded-full bg-accent/10 blur-2xl"></div>
          <div class="relative space-y-3">
            {PROJECTS.map((project) => (
              <a
                href={project.url[lang]}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
                class="group flex items-center justify-between gap-4 rounded-2xl border border-border bg-canvas/70 px-4 py-3.5 transition-colors hover:border-accent/50 hover:bg-surface"
              >
                <div class="min-w-0">
                  <p class="text-sm font-bold text-ink group-hover:text-accent" dir="ltr">{project.name}</p>
                  <p class="mt-0.5 truncate text-xs text-muted">{project.category[lang]}</p>
                </div>
                <span class="shrink-0 font-mono text-[11px] text-accent" dir="ltr">
                  {project.domainLabel}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. How We Build / Why Arshid Tech (Harris framed steps + checkmarks) -->
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-12">
      <!-- Framed Steps Column -->
      <div class="flex flex-col items-center lg:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
          {t.howItWorks.frameLabel}
        </p>
        <div class="my-3 h-7 w-px border-s border-dashed border-accent/40"></div>

        <div class="relative w-full overflow-hidden rounded-3xl border border-border bg-surface-soft/70 p-4 sm:p-5">
          <div class="pointer-events-none absolute -bottom-10 -end-10 h-44 w-44 rounded-full bg-aqua/20 blur-2xl"></div>
          <div class="relative space-y-3">
            {t.howItWorks.steps.map((step, index) => (
              <div class="flex items-center gap-4 rounded-2xl border border-border/80 bg-surface px-4 py-3.5 shadow-[0_1px_2px_rgba(6,50,59,0.03)]">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
                  {index === 0 && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="11" cy="11" r="8"></circle>
                      <path d="m21 21-4.3-4.3"></path>
                    </svg>
                  )}
                  {index === 1 && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                      <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                      <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                      <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                  )}
                  {index === 2 && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  )}
                  {index === 3 && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                      <polyline points="16 7 22 7 22 13"></polyline>
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="text-sm font-bold text-ink">{step.title}</h3>
                  <p class="mt-0.5 text-xs leading-5 text-muted">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="my-3 h-7 w-px border-s border-dashed border-accent/40"></div>
        <p class="text-center text-sm font-bold text-ink">{t.howItWorks.frameFooter}</p>
      </div>

      <!-- Narrative & Checkmarks Column -->
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
          {t.howItWorks.eyebrow}
        </p>
        <h2 class="heading-editorial mt-3 text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.6rem]">
          {t.howItWorks.title}
        </h2>
        <p class="mt-5 text-base leading-8 text-muted">
          {t.howItWorks.p1}
        </p>
        <p class="mt-4 text-base leading-8 text-muted">
          {t.howItWorks.p2}
        </p>

        <ul class="mt-8 space-y-5">
          {t.howItWorks.checks.map((item) => (
            <li class="flex items-start gap-3.5">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-accent text-accent">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-accent">{item.title}</p>
                <p class="mt-1 text-sm leading-6 text-muted">{item.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 3. Approach Cards Section (Harris 3-card grid) -->
<section class="border-t border-border/70 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
        {t.approach.eyebrow}
      </p>
      <h2 class="heading-editorial mt-3 text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.7rem]">
        {t.approach.title}
      </h2>
      <p class="mt-5 text-base leading-8 text-muted">
        {t.approach.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.approach.cards.map((card, index) => (
        <div class="rounded-2xl border border-border bg-surface p-7 shadow-[0_1px_3px_rgba(6,50,59,0.03)]">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent">
            {index === 0 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 2v20M2 12h20"></path>
                <rect x="6" y="6" width="12" height="12" rx="2"></rect>
              </svg>
            )}
            {index === 1 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                <polyline points="16 7 22 7 22 13"></polyline>
              </svg>
            )}
            {index === 2 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            )}
          </div>
          <h3 class="mt-6 text-lg font-bold text-ink">{card.title}</h3>
          <p class="mt-3 text-sm leading-7 text-muted">{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 4. Dark Teal Philosophy Quote Card (Exact Harris Callout) -->
<section class="py-10 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-[#06323B] px-8 py-14 text-white sm:px-14 sm:py-20">
      <div class="pointer-events-none absolute -bottom-16 -end-16 h-64 w-64 rounded-full bg-aqua/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div class="font-serif text-5xl leading-none text-aqua/70" aria-hidden="true">“</div>
          <blockquote class="heading-editorial mt-4 text-2xl leading-snug sm:text-3xl lg:text-[2.1rem]">
            <span class="text-white">{t.quote.quoteWhite} </span>
            <span class="text-aqua">{t.quote.quoteAqua}</span>
          </blockquote>
        </div>
        <div class="lg:col-span-6">
          <div class="h-0.5 w-10 bg-aqua"></div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-aqua">
            {t.quote.eyebrow}
          </p>
          <p class="mt-4 text-base leading-8 text-white/85">
            {t.quote.body}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5. Portfolio / Products Preview -->
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
        <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20"></path>
        </svg>
        <span>{t.portfolioPreview.badge}</span>
      </span>
      <h2 class="heading-editorial mt-6 text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.75rem]">
        <span class="block">{t.portfolioPreview.titleMain}</span>
        <span class="mt-1 block text-accent">{t.portfolioPreview.titleAccent}</span>
      </h2>
      <p class="mt-5 text-base leading-8 text-muted">
        {t.portfolioPreview.p1}
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {PROJECTS.map((project) => (
        <article class="flex flex-col justify-between rounded-2xl border border-border bg-surface p-7 transition-colors hover:border-accent/50">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
                {project.category[lang]}
              </span>
              <span class="font-mono text-xs text-muted" dir="ltr">
                {project.domainLabel}
              </span>
            </div>
            <h3 class="heading-editorial mt-4 text-2xl text-ink" dir="ltr">{project.name}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">
              {project.summary[lang]}
            </p>
          </div>

          <div class="mt-6 flex items-center justify-between border-t border-border pt-4 text-sm">
            <a
              href={project.url[lang]}
              target={project.external ? '_blank' : undefined}
              rel={project.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 font-semibold text-accent transition-colors hover:text-ink"
            >
              <span>{project.external ? t.portfolioPreview.openPlatform : t.portfolioPreview.viewDetails}</span>
              <span aria-hidden="true">{arrow}</span>
            </a>

            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-muted transition-colors hover:text-ink"
              >
                GitHub
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 6. Harris-Style Gradient CTA Banner -->
<CtaBanner lang={lang} />
