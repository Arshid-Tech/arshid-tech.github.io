---
import { getCollection } from 'astro:content';
import { COMPANY, PROJECTS, SERVICES, UI, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = UI[lang];
const services = SERVICES[lang];
const blogPrefix = lang === 'fa' ? '/blog/' : '/en/blog/';

const allPosts = await getCollection('blog', ({ id, data }) => {
  return id.startsWith(`${lang}/`) && !data.draft;
});

const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date, locale: Locale) {
  return new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<!-- Hero Section -->
<section class="border-b border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded border border-border bg-bg px-3 py-1 text-xs font-medium text-primary">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{t.hero.eyebrow}</span>
      </div>
      <h1 class="mt-6 text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
        {t.hero.title}
      </h1>
      <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
        {t.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#products"
          class="inline-flex items-center rounded bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          {t.hero.primaryCta}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center rounded border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-primary hover:text-primary"
        >
          {t.hero.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Products Grid -->
<section id="products" class="border-b border-border py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t.sections.productsEyebrow}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">{t.sections.productsTitle}</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">{t.sections.productsSubtitle}</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {PROJECTS.map((project) => (
        <article class="flex flex-col justify-between rounded-md border border-border bg-surface p-6 transition-colors hover:border-primary/50">
          <div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="inline-block rounded bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-primary">
                  {project.tag[lang]}
                </span>
                <h3 class="mt-2.5 text-xl font-bold text-ink" dir="ltr">{project.name}</h3>
              </div>
              <span class="rounded border border-border bg-bg px-2 py-1 font-mono text-[11px] text-muted" dir="ltr">
                {project.domainLabel}
              </span>
            </div>

            <p class="mt-4 text-sm leading-7 text-muted">
              {project.summary[lang]}
            </p>

            <div class="mt-5 flex flex-wrap gap-2" dir="ltr">
              {project.stack.map((tech) => (
                <span class="rounded border border-border bg-bg px-2 py-0.5 text-xs text-muted">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 text-sm">
            <a
              href={project.url[lang]}
              target={project.external ? '_blank' : undefined}
              rel={project.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 font-semibold text-primary transition-colors hover:text-primary-dark"
            >
              <span>{project.external ? t.sections.openApp : t.sections.viewProduct}</span>
              <span aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span>
            </a>

            {project.githubUrl ? (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-muted transition-colors hover:text-ink"
              >
                {t.sections.sourceCode}
              </a>
            ) : (
              <span class="text-xs text-muted/80">{t.sections.privateSource}</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Services Grid -->
<section id="services" class="border-b border-border bg-surface py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t.sections.servicesEyebrow}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">{t.sections.servicesTitle}</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">{t.sections.servicesSubtitle}</p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {services.map((service) => (
        <div class="rounded-md border border-border bg-bg p-6">
          <p class="font-mono text-xs text-accent" dir="ltr">{service.code}</p>
          <h3 class="mt-2 text-lg font-bold text-ink">{service.title}</h3>
          <p class="mt-2.5 text-sm leading-7 text-muted">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Blog Preview -->
{latestPosts.length > 0 && (
  <section id="blog" class="border-b border-border py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t.sections.blogEyebrow}</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">{t.sections.blogTitle}</h2>
        </div>
        <a href={blogPrefix} class="text-sm font-semibold text-primary hover:text-primary-dark">
          {t.sections.allPosts} {lang === 'fa' ? '←' : '→'}
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {latestPosts.map((post) => {
          const slug = post.id.replace(`${lang}/`, '');
          return (
            <article class="flex flex-col justify-between rounded-md border border-border bg-surface p-6">
              <div>
                <div class="flex items-center justify-between gap-2 text-xs text-muted">
                  <span class="font-medium text-accent">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate, lang)}
                  </time>
                </div>
                <h3 class="mt-3 text-base font-bold leading-7 text-ink">
                  <a href={`${blogPrefix}${slug}/`} class="hover:text-primary">
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-2.5 text-sm leading-7 text-muted line-clamp-3">
                  {post.data.description}
                </p>
              </div>
              <div class="mt-5 pt-4 border-t border-border">
                <a href={`${blogPrefix}${slug}/`} class="text-xs font-semibold text-primary hover:text-primary-dark">
                  {t.sections.readMore} {lang === 'fa' ? '←' : '→'}
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<!-- About & Contact -->
<section id="about" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">{t.sections.aboutEyebrow}</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">{t.sections.aboutTitle}</h2>
        <p class="mt-4 text-sm leading-8 text-muted sm:text-base">{t.sections.aboutBody}</p>
      </div>

      <div id="contact" class="rounded-md border border-border bg-surface p-6 lg:col-span-5">
        <h3 class="text-lg font-bold text-ink">{t.sections.contactTitle}</h3>
        <p class="mt-2 text-sm leading-7 text-muted">{t.sections.contactSubtitle}</p>
        <div class="mt-6 space-y-3 text-sm">
          <div class="flex items-center justify-between rounded border border-border bg-bg px-4 py-3">
            <span class="text-xs text-muted">{lang === 'fa' ? 'ایمیل رسمی' : 'Official Email'}</span>
            <a href={`mailto:${COMPANY.email}`} class="font-mono font-semibold text-primary hover:underline" dir="ltr">
              {COMPANY.email}
            </a>
          </div>
          <div class="flex items-center justify-between rounded border border-border bg-bg px-4 py-3">
            <span class="text-xs text-muted">GitHub</span>
            <a
              href={COMPANY.githubOrg}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono font-semibold text-ink hover:text-primary"
              dir="ltr"
            >
              github.com/Arshid-Tech
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
