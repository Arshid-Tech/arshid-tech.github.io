---
import { CONTENT, type Locale } from '../data/site';
import CtaBanner from './CtaBanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = CONTENT[lang].philosophyPage;
const quote = CONTENT[lang].quote;
---

<!-- Hero -->
<section class="border-b border-border/70 bg-canvas py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>{p.badge}</span>
      </span>

      <h1 class="heading-editorial mt-6 text-4xl leading-[1.18] text-ink sm:text-5xl lg:text-[3.5rem]">
        <span class="block">{p.heroTitleMain}</span>
        <span class="mt-1 block text-accent">{p.heroTitleAccent}</span>
      </h1>

      <p class="mt-7 text-base leading-8 text-muted sm:text-[1.06rem]">
        <strong class="font-semibold text-ink">{p.heroLead}</strong> {p.heroP1}
      </p>
      <p class="mt-4 text-base leading-8 text-muted sm:text-[1.06rem]">
        {p.heroP2}
      </p>
    </div>
  </div>
</section>

<!-- 4-Column Pillars (Harris Our Philosophy 4-column grid with vertical dividers) -->
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="heading-editorial text-3xl text-ink sm:text-4xl lg:text-[2.75rem]">
        {p.pillarsTitle}
      </h2>
      <p class="mt-4 text-base leading-8 text-muted">
        {p.pillarsSubtitle}
      </p>
    </div>

    <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-border rtl:lg:divide-x-reverse">
      {p.pillars.map((pillar, index) => (
        <div class="flex flex-col items-center px-4 text-center lg:px-7">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-accent-soft text-accent">
            {index === 0 && (
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
            )}
            {index === 1 && (
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 8v8M8 12h8"></path>
              </svg>
            )}
            {index === 2 && (
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
            {index === 3 && (
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            )}
          </div>
          <h3 class="heading-editorial mt-6 text-xl text-ink">{pillar.title}</h3>
          <p class="mt-3 text-sm leading-7 text-muted">{pillar.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Dark Quote Callout -->
<section class="py-8 sm:py-14">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-[#06323B] px-8 py-14 text-white sm:px-14 sm:py-20">
      <div class="pointer-events-none absolute -bottom-16 -end-16 h-64 w-64 rounded-full bg-aqua/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div class="font-serif text-5xl leading-none text-aqua/70" aria-hidden="true">“</div>
          <blockquote class="heading-editorial mt-4 text-2xl leading-snug sm:text-3xl lg:text-[2.1rem]">
            <span class="text-white">{quote.quoteWhite} </span>
            <span class="text-aqua">{quote.quoteAqua}</span>
          </blockquote>
        </div>
        <div class="lg:col-span-6">
          <div class="h-0.5 w-10 bg-aqua"></div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-aqua">
            {quote.eyebrow}
          </p>
          <p class="mt-4 text-base leading-8 text-white/85">
            {quote.body}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What Defines Our Products (Harris "What You Can Expect" list style) -->
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
      {p.expectEyebrow}
    </p>
    <h2 class="heading-editorial mt-3 text-3xl text-ink sm:text-4xl">
      {p.expectTitle}
    </h2>

    <div class="mt-10 space-y-6">
      {p.expectItems.map((item, index) => (
        <div class="flex items-start gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            {index === 0 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            )}
            {index === 1 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                <polyline points="16 7 22 7 22 13"></polyline>
              </svg>
            )}
            {index === 2 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
            )}
            {index === 3 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            )}
          </div>
          <div>
            <h3 class="text-base font-bold text-ink">{item.title}</h3>
            <p class="mt-1 text-sm leading-7 text-muted">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />
