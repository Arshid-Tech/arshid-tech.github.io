---
import { CONTENT, PROJECTS, type Locale } from '../data/site';
import CtaBanner from './CtaBanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = CONTENT[lang].portfolioPage;
const labels = CONTENT[lang].portfolioPreview;
const arrow = lang === 'fa' ? '←' : '→';
---

<section class="bg-canvas py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
      <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
      </svg>
      <span>{p.badge}</span>
    </span>

    <h1 class="heading-editorial mt-7 text-4xl leading-[1.18] text-ink sm:text-5xl lg:text-[3.5rem]">
      <span class="block">{p.titleMain}</span>
      <span class="mt-1 block text-accent">{p.titleAccent}</span>
    </h1>

    <p class="mx-auto mt-7 max-w-2xl text-base leading-8 text-muted">
      {p.p1}
    </p>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-muted">
      {p.p2}
    </p>
  </div>

  <div class="mx-auto mt-16 max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {PROJECTS.map((project) => (
        <article class="flex flex-col justify-between rounded-2xl border border-border bg-surface p-7 transition-colors hover:border-accent/50">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
                {project.category[lang]}
              </span>
              <span class="font-mono text-xs text-muted" dir="ltr">
                {project.domainLabel}
              </span>
            </div>
            <h2 class="heading-editorial mt-4 text-2xl text-ink" dir="ltr">{project.name}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">
              {project.summary[lang]}
            </p>
          </div>

          <div class="mt-6 flex items-center border-t border-border pt-4 text-sm">
            <a
              href={project.url[lang]}
              target={project.external ? '_blank' : undefined}
              rel={project.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 font-semibold text-accent transition-colors hover:text-ink"
            >
              <span>{project.external ? labels.openPlatform : labels.viewDetails}</span>
              <span aria-hidden="true">{arrow}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />
