---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COMPANY, type Locale } from '../data/site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternateFaPath: string;
  alternateEnPath: string;
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternateFaPath,
  alternateEnPath,
  jsonLd,
} = Astro.props;

const dir = lang === 'fa' ? 'rtl' : 'ltr';
const site = COMPANY.siteUrl;
const canonicalUrl = new URL(canonicalPath, site).toString();
const faUrl = new URL(alternateFaPath, site).toString();
const enUrl = new URL(alternateEnPath, site).toString();
const alternatePath = lang === 'fa' ? alternateEnPath : alternateFaPath;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY.legalName[lang],
  alternateName: 'Arshid Tech',
  url: site,
  email: COMPANY.email,
  sameAs: [COMPANY.githubOrg],
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.address.en,
    addressLocality: 'Robat Karim',
    addressRegion: 'Tehran',
    postalCode: '3761946835',
    addressCountry: 'IR',
  },
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fa-IR" href={faUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={faUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={COMPANY.brand[lang]} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-ink">
    <Header lang={lang} alternatePath={alternatePath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
