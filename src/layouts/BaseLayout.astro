---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COMPANY, type Locale } from '../data/site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternateFaPath: string;
  alternateEnPath: string;
  activeNav?: 'home' | 'philosophy' | 'portfolio' | 'blog' | 'contact';
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternateFaPath,
  alternateEnPath,
  activeNav = 'home',
  jsonLd,
} = Astro.props;

const dir = lang === 'fa' ? 'rtl' : 'ltr';
const site = COMPANY.siteUrl;
const canonicalUrl = new URL(canonicalPath, site).toString();
const faUrl = new URL(alternateFaPath, site).toString();
const enUrl = new URL(alternateEnPath, site).toString();
const alternatePath = lang === 'fa' ? alternateEnPath : alternateFaPath;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY.brand[lang],
  alternateName: 'Arshid Tech',
  url: site,
  logo: `${site}/images/brand/logo-vertical-en.svg`,
  email: COMPANY.email,
  sameAs: [COMPANY.telegramChannel],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fa-IR" href={faUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={faUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={COMPANY.brand[lang]} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink">
    <Header lang={lang} alternatePath={alternatePath} activeNav={activeNav} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
