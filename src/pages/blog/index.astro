---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('fa/') && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
}
---

<BaseLayout
  lang="fa"
  title="وبلاگ فنی و سلامت دیجیتال | آرشید تک"
  description="مقالات تخصصی مهندسی نرم‌افزار سلامت، داروسازی دیجیتال، معماری آفلاین‌محور و گزارش‌های فنی تیم آرشید تک."
  canonicalPath="/blog/"
  alternateFaPath="/blog/"
  alternateEnPath="/en/blog/"
>
  <section class="border-b border-border bg-surface py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-accent">وبلاگ آرشید تک</p>
      <h1 class="mt-2 text-3xl font-extrabold text-ink">یادداشت‌های فنی و نرم‌افزار سلامت</h1>
      <p class="mt-3 text-sm leading-7 text-muted">
        تجربه‌های مهندسی در طراحی ابزارهای بالینی، آموزش دیجیتال داروسازی و زیرساخت‌های وب.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8">
      {posts.map((post) => {
        const slug = post.id.replace('fa/', '');
        return (
          <article class="rounded-md border border-border bg-surface p-6 transition-colors hover:border-primary/50">
            <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
              <span class="font-medium text-accent">{post.data.category}</span>
              <span>•</span>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold text-ink">
              <a href={`/blog/${slug}/`} class="hover:text-primary">{post.data.title}</a>
            </h2>
            <p class="mt-2.5 text-sm leading-7 text-muted">{post.data.description}</p>
            <div class="mt-4">
              <a href={`/blog/${slug}/`} class="text-xs font-semibold text-primary hover:text-primary-dark">
                مطالعه کامل ←
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
