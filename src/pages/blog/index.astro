---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('fa/') && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
}
---

<BaseLayout
  lang="fa"
  title="وبلاگ | آرشید تک"
  description="یادداشت‌های فنی و تخصصی درباره مهندسی نرم‌افزار سلامت، داروسازی دیجیتال و معماری آفلاین‌محور."
  canonicalPath="/blog/"
  alternateFaPath="/blog/"
  alternateEnPath="/en/blog/"
  activeNav="blog"
>
  <section class="border-b border-border/70 bg-canvas py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold text-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>وبلاگ آرشید تک</span>
      </span>
      <h1 class="heading-editorial mt-5 text-2xl text-ink sm:mt-6 sm:text-5xl">یادداشت‌های فناوری سلامت</h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-8 text-muted sm:text-base">
        تجربه‌های ما در طراحی ابزارهای بالینی، آموزش دیجیتال داروسازی و زیرساخت‌های نرم‌افزاری.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-4xl space-y-5 px-4 sm:space-y-6 sm:px-6 lg:px-8">
      {posts.map((post) => {
        const slug = post.id.replace('fa/', '');
        return (
          <article class="rounded-2xl border border-border bg-surface p-5 transition-colors hover:border-accent/50 sm:p-7">
            <div class="flex flex-wrap items-center gap-2.5 text-xs text-muted sm:gap-3">
              <span class="rounded-full bg-accent-soft px-3 py-0.5 font-semibold text-accent">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>
            <h2 class="heading-editorial mt-4 text-lg text-ink sm:text-2xl">
              <a href={`/blog/${slug}/`} class="transition-colors hover:text-accent">{post.data.title}</a>
            </h2>
            <p class="mt-3 text-sm leading-7 text-muted">{post.data.description}</p>
            <div class="mt-5">
              <a href={`/blog/${slug}/`} class="text-xs font-semibold text-accent hover:text-ink">
                مطالعه کامل ←
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
