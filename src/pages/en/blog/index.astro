---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
}
---

<BaseLayout
  lang="en"
  title="Blog | Arshid Tech"
  description="Technical notes on clinical software engineering, digital pharmacy platforms, and offline-first architecture."
  canonicalPath="/en/blog/"
  alternateFaPath="/blog/"
  alternateEnPath="/en/blog/"
  activeNav="blog"
>
  <section class="border-b border-border/70 bg-canvas py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span>Arshid Tech Blog</span>
      </span>
      <h1 class="heading-editorial mt-6 text-3xl text-ink sm:text-5xl">HealthTech Engineering Notes</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-muted">
        Practical writing on clinical decision support tools, pharmacy education software, and dependable architecture.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8">
      {posts.map((post) => {
        const slug = post.id.replace('en/', '');
        return (
          <article class="rounded-2xl border border-border bg-surface p-7 transition-colors hover:border-accent/50">
            <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
              <span class="rounded-full bg-accent-soft px-3 py-0.5 font-semibold text-accent">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>
            <h2 class="heading-editorial mt-4 text-xl text-ink sm:text-2xl">
              <a href={`/en/blog/${slug}/`} class="transition-colors hover:text-accent">{post.data.title}</a>
            </h2>
            <p class="mt-3 text-sm leading-7 text-muted">{post.data.description}</p>
            <div class="mt-5">
              <a href={`/en/blog/${slug}/`} class="text-xs font-semibold text-accent hover:text-ink">
                Read article →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
